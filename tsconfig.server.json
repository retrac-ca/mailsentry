{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/server/**/*.ts",
    "src/core/**/*.ts",
    "src/providers/**/*.ts",
    "src/diagnostics/**/*.ts",
    "src/security/**/*.ts",
    "src/shared/**/*.ts",
    "src/cli/**/*.ts",
    "src/bench/**/*.ts",
    "src/desktop/**/*.ts"
  ]
}
