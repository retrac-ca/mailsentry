# ---------------------------------------------------------------------------
# MailSentry configuration
# Copy to .env and fill in only what you need. Never commit .env.
# The server loads .env automatically at startup (existing environment
# variables take precedence).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------
# Windows desktop: the packaged app reads this from
# %APPDATA%\MailSentry\.env. Use exactly 127.0.0.1:4310 for desktop.
# ---------------------------------------------------------------

# HTTP server. Loopback is enforced unless MAILSENTRY_ALLOW_NONLOCAL=true.
PORT=4310
MAILSENTRY_HOST=127.0.0.1
# Must match how you open the app; used for OAuth redirects.
# Origin only (no path); the port must match PORT.
MAILSENTRY_BASE_URL=http://127.0.0.1:4310

# debug | info | warn | error
MAILSENTRY_LOG_LEVEL=info

# Set only if you have reviewed the security implications of a non-loopback bind.
# MAILSENTRY_ALLOW_NONLOCAL=false

# ---------------------------------------------------------------------------
# Gmail (optional). Create a Google Cloud OAuth 2.0 "Desktop app" client.
# Google Desktop clients do not require manual redirect-URI registration.
# MailSentry handles the loopback callback at
# ${MAILSENTRY_BASE_URL}/auth/gmail/callback.
# Google issues a client secret, but Desktop client secrets are not
# confidential; PKCE protects the flow. Keep the value server-side.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# Desktop app clients receive a non-confidential client secret.
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Microsoft 365 / Outlook (optional). Register an app in Microsoft Entra ID.
# Recommended: a public client ("Mobile and desktop applications") with PKCE
# and no client secret.
# Redirect URI: ${MAILSENTRY_BASE_URL}/auth/microsoft/callback
# Enable public client flows if your tenant requires it.
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
# Leave blank for a public client; only confidential Web clients need this.
MICROSOFT_CLIENT_SECRET=
# common | organizations | consumers | a tenant ID
MICROSOFT_TENANT_ID=common
